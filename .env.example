# ==============================================================================
# LOCASH - CONFIGURAÇÕES DO SUPABASE NA NUVEM
# Crie um projeto gratuito em https://supabase.com e adicione suas chaves abaixo
# ==============================================================================

# URL do seu Projeto Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (Project Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
